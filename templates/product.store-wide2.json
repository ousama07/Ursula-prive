    "ss-feature-54-1": {
      "type": "ss-feature-54",
      "blocks": {
        "ss-heading-1": {
          "type": "heading",
          "settings": {
            "heading": "<h2>Vístete en un minuto y sal con la silueta ya cuidada</h2>",
