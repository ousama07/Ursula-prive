        "ss-feature-4": {
          "type": "feature",
          "settings": {
            "icon": "bolt",
            "title": "Un gesto y ya estás lista",
            "text": "<p>Piezas pensadas para ponértelas y salir: la comodidad se siente al caminar y la línea se ve terminada desde el primer paso.</p>",
            "hide_mobile": false
          }
        },
        "ss-feature-5": {
          "type": "feature",
          "settings": {
            "icon": "feather",
            "title": "Relajada, con trazo femenino",
            "text": "<p>Volúmenes suaves y un acabado que estiliza, para que el día se vea considerado sin montar un look desde cero.</p>",
            "hide_mobile": false
          }
        },
        "ss-feature-6": {
          "type": "feature",
          "settings": {
            "icon": "heart",
            "title": "Se habla con el resto del armario",
            "text": "<p>Tonos y siluetas que se mezclan entre sí, para que cada mañana sea una decisión corta, no una negociación.</p>",
            "hide_mobile": false
          }
