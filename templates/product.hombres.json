                "custom_liquid": "<div class=\"ursula-benefits-small\">\n  <div class=\"ursula-benefit-small\">\n    <div class=\"ursula-icon-small ursula-30-small\">\n      <span>30</span>\n      <small>GIORNI</small>\n    </div>\n    <span>Reso e rimborso entro 30 giorni</span>\n  </div>\n\n  <div class=\"ursula-benefit-small\">\n    <div class=\"ursula-icon-small ursula-pt-small\">PT</div>\n    <span>Spedizione gratuita in tutta Italia</span>\n  </div>\n\n  <div class=\"ursula-benefit-small\">\n    <div class=\"ursula-icon-small ursula-flag-small\"></div>\n    <span>Azienda italiana dal 1986</span>\n  </div>\n</div>\n\n<style>\n.ursula-benefits-small {\n  display: flex;\n  flex-direction: column;\n  gap: 9px;\n  margin: 6px 0;\n  font-family: inherit;\n}\n\n.ursula-benefit-small {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 14px;\n  line-height: 1.2;\n  color: #171717;\n}\n\n.ursula-icon-small {\n  width: 30px;\n  height: 30px;\n  min-width: 30px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-sizing: border-box;\n}\n\n.ursula-30-small {\n  background: #fff7dc;\n  border: 1.5px solid #e4ae25;\n  outline: 1px solid #e4ae25;\n  outline-offset: -4px;\n  flex-direction: column;\n  font-weight: 700;\n  line-height: 1;\n}\n\n.ursula-30-small span {\n  font-size: 11px;\n}\n\n.ursula-30-small small {\n  font-size: 6px;\n  margin-top: 2px;\n}\n\n.ursula-pt-small {\n  background: #ffdc00;\n  color: #0084c7;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.ursula-flag-small {\n  background: linear-gradient(\n    to right,\n    #009246 0%, #009246 33.33%,\n    #fff 33.33%, #fff 66.66%,\n    #ce2b37 66.66%, #ce2b37 100%\n  );\n}\n\n</style>"
