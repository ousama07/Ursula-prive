            "custom_liquid_VQfzWh": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "disabled": true,
              "settings": {
                "custom_liquid": "<div class=\"ursula-sale-box\">\n  <div class=\"ursula-sale-top\">\n    <span class=\"ursula-sale-dot\"></span>\n    LIQUIDAZIONE STRAORDINARIA\n  </div>\n\n  <div class=\"ursula-sale-discount\">-50%</div>\n\n  <div class=\"ursula-sale-message\">\n    SCONTO SU TUTTI I PRODOTTI\n  </div>\n\n  <div class=\"ursula-sale-divider\"></div>\n\n  <div class=\"ursula-sale-timer-title\">\n    OFFERTA A TEMPO LIMITATO\n  </div>\n\n  <div class=\"ursula-countdown\">\n    <div class=\"ursula-time\">\n      <strong class=\"ursula-hours\">12</strong>\n      <small>ORE</small>\n    </div>\n\n    <span class=\"ursula-separator\">:</span>\n\n    <div class=\"ursula-time\">\n      <strong class=\"ursula-minutes\">00</strong>\n      <small>MIN</small>\n    </div>\n\n    <span class=\"ursula-separator\">:</span>\n\n    <div class=\"ursula-time\">\n      <strong class=\"ursula-seconds\">00</strong>\n      <small>SEC</small>\n    </div>\n  </div>\n\n  <div class=\"ursula-sale-footer\">\n    ULTIME OCCASIONI PER ACQUISTARE\n  </div>\n</div>\n\n<style>\n.ursula-sale-box {\n  width: 100%;\n  box-sizing: border-box;\n  border: 1px solid #d62828;\n  background: #fffafa;\n  padding: 15px 12px;\n  text-align: center;\n  color: #c92323;\n  font-family: inherit;\n  margin: 14px 0;\n  border-radius: 5px;\n}\n\n.ursula-sale-top {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1.1px;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 7px;\n}\n\n.ursula-sale-dot {\n  width: 7px;\n  height: 7px;\n  background: #d62828;\n  border-radius: 50%;\n  animation: ursula-pulse 1.2s infinite;\n}\n\n.ursula-sale-discount {\n  font-size: 43px;\n  font-weight: 800;\n  line-height: 1.15;\n  margin-top: 5px;\n  letter-spacing: -2px;\n}\n\n.ursula-sale-message {\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 1px;\n}\n\n.ursula-sale-divider {\n  height: 1px;\n  background: #edcaca;\n  margin: 12px 10px;\n}\n\n.ursula-sale-timer-title {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 1.2px;\n  margin-bottom: 9px;\n}\n\n.ursula-countdown {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 9px;\n}\n\n.ursula-time {\n  width: 55px;\n  height: 55px;\n  background: #fff;\n  border: 1px solid #e5b6b6;\n  border-radius: 5px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n}\n\n.ursula-time strong {\n  font-size: 23px;\n  line-height: 1.1;\n  font-weight: 800;\n}\n\n.ursula-time small {\n  font-size: 9px;\n  font-weight: 600;\n  margin-top: 3px;\n}\n\n.ursula-separator {\n  font-size: 22px;\n  font-weight: 700;\n}\n\n.ursula-sale-footer {\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .8px;\n  margin-top: 12px;\n}\n\n@keyframes ursula-pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: .3; }\n}\n\n@media (max-width: 380px) {\n  .ursula-sale-box {\n    padding: 12px 8px;\n  }\n\n  .ursula-time {\n    width: 49px;\n    height: 49px;\n  }\n}\n</style>\n\n<script>\n(function() {\n  function initUrsulaTimer() {\n    var boxes = document.querySelectorAll('.ursula-sale-box');\n\n    boxes.forEach(function(box) {\n      if (box.dataset.timerStarted === 'true') return;\n\n      box.dataset.timerStarted = 'true';\n\n      var storageKey = 'ursula_sale_end_2026';\n      var duration = 12 * 60 * 60 * 1000;\n      var endDate;\n\n      try {\n        endDate = Number(localStorage.getItem(storageKey));\n\n        if (!endDate || !Number.isFinite(endDate)) {\n          endDate = Date.now() + duration;\n          localStorage.setItem(storageKey, String(endDate));\n        }\n      } catch(e) {\n        endDate = Date.now() + duration;\n      }\n\n      var hours = box.querySelector('.ursula-hours');\n      var minutes = box.querySelector('.ursula-minutes');\n      var seconds = box.querySelector('.ursula-seconds');\n      var title = box.querySelector('.ursula-sale-timer-title');\n\n      function update() {\n        var remaining = Math.max(0, endDate - Date.now());\n\n        var h = Math.floor(remaining / 3600000);\n        var m = Math.floor((remaining % 3600000) / 60000);\n        var s = Math.floor((remaining % 60000) / 1000);\n\n        hours.textContent = String(h).padStart(2, '0');\n        minutes.textContent = String(m).padStart(2, '0');\n        seconds.textContent = String(s).padStart(2, '0');\n\n        if (remaining <= 0) {\n          title.textContent = 'PROMOZIONE TERMINATA';\n        }\n      }\n\n      update();\n\n      var interval = setInterval(function() {\n        update();\n\n        if (Date.now() >= endDate) {\n          clearInterval(interval);\n        }\n      }, 1000);\n    });\n  }\n\n  initUrsulaTimer();\n})();\n</script>"
