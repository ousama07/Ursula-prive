            "custom_liquid_yUrz9p": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{%- comment -%}\n  Ursula Privée · Badge \"Ordina ORA\"\n  ora_limite: hora límite del día (hora italiana). Después de esa hora pasa al día laborable siguiente.\n  azione: lo que pasa con el pedido ese día.\n{%- endcomment -%}\n{%- assign ora_limite = 14 -%}\n{%- assign azione = 'elaborato' -%}\n\n<div class=\"up-ship-today\" data-cutoff=\"{{ ora_limite }}\" data-azione=\"{{ azione }}\">\n  <span class=\"up-ship-today__icon\" aria-hidden=\"true\">\n    <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M1 4h13v11H1z\"/>\n      <path d=\"M14 8h4l3 3v4h-7z\"/>\n      <circle cx=\"5.5\" cy=\"17.5\" r=\"2\"/>\n      <circle cx=\"17.5\" cy=\"17.5\" r=\"2\"/>\n    </svg>\n  </span>\n  <span class=\"up-ship-today__text\">\n    <span class=\"up-ship-today__dot\" aria-hidden=\"true\"></span>\n    <span class=\"up-ship-today__msg\">Ordina <strong>ORA</strong> e il tuo ordine verrà <strong>{{ azione }} oggi</strong></span>\n  </span>\n</div>\n\n<style>\n  .up-ship-today{display:flex;align-items:center;gap:12px;margin:10px 0;font-size:14px;line-height:1.35;color:inherit}\n  .up-ship-today__icon{flex:0 0 30px;width:30px;height:30px;border-radius:50%;background:#e7f6ec;color:#1a7f37;display:flex;align-items:center;justify-content:center}\n  .up-ship-today__text{display:flex;align-items:center;gap:8px}\n  .up-ship-today__dot{position:relative;flex:0 0 9px;width:9px;height:9px;border-radius:50%;background:#22c55e}\n  .up-ship-today__dot::after{content:\"\";position:absolute;inset:0;border-radius:50%;background:#22c55e;animation:upPulse 1.6s ease-out infinite}\n  @keyframes upPulse{0%{transform:scale(1);opacity:.7}100%{transform:scale(2.6);opacity:0}}\n  @media (prefers-reduced-motion:reduce){.up-ship-today__dot::after{animation:none}}\n</style>\n\n<script>\n  (function(){\n    var els = document.querySelectorAll('.up-ship-today');\n    if (!els.length) return;\n    var giorni = ['domenica','lunedì','martedì','mercoledì','giovedì','venerdì','sabato'];\n    var mappa = {Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6};\n\n    function oraRoma(){\n      var parti = new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Rome',weekday:'short',hour:'2-digit',hour12:false}).formatToParts(new Date());\n      var o = {};\n      parti.forEach(function(p){ o[p.type] = p.value; });\n      return { d: mappa[o.weekday], h: parseInt(o.hour,10) % 24 };\n    }\n\n    function prossimoLavorativo(d){\n      var n = (d + 1) % 7;\n      while (n === 0 || n === 6) n = (n + 1) % 7;\n      return n;\n    }\n\n    function aggiorna(){\n      var t = oraRoma();\n      var lavorativo = t.d >= 1 && t.d <= 5;\n      els.forEach(function(el){\n        var cutoff = parseInt(el.getAttribute('data-cutoff'),10);\n        var azione = el.getAttribute('data-azione');\n        var msg = el.querySelector('.up-ship-today__msg');\n        var quando;\n        if (lavorativo && t.h < cutoff){\n          quando = 'oggi';\n        } else {\n          var n = prossimoLavorativo(t.d);\n          quando = (n === (t.d + 1) % 7) ? 'domani' : giorni[n];\n        }\n        msg.innerHTML = 'Ordina <strong>ORA</strong> e il tuo ordine verrà <strong>' + azione + ' ' + quando + '</strong>';\n      });\n    }\n\n    aggiorna();\n    setInterval(aggiorna, 60000);\n  })();\n</script>"
              },
