            "custom_liquid": "{%- comment -%}\n  ÚRSULA PRIVÉE · COLECCIONES (versión compacta)\n  Este comentario lo elimina Shopify antes de enviar la página: no pesa nada.\n\n  ENCUADRE — un valor por colección, en el mismo orden que ce_h:\n    ce_p  → tablet y escritorio · ce_pm → móvil\n    \"horizontal vertical\": 0% izquierda/arriba · 50% centro · 100% derecha/abajo\n{%- endcomment -%}\n{%- liquid\n  assign ce_h = 'mosaicos|conjuntos-americanas|vestidos' | split: '|'\n  assign ce_p = '50% 20%|50% 20%|20% 30%' | split: '|'\n  assign ce_pm = '50% 20%|50% 16%|10% 50%' | split: '|'\n  capture ce_txt\n    echo 'Colecciones'\n    for h in ce_h\n      echo collections[h].title\n    endfor\n  endcapture\n-%}\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&text={{ ce_txt | url_encode }}&display=swap\" media=\"print\" onload=\"this.media='all'\">\n<section class=\"ce\" aria-labelledby=\"ce-h-{{ section.id }}\"><div class=\"ce-w\"><header class=\"ce-h\"><p class=\"ce-e\">Descubre nuestra selección</p><h2 id=\"ce-h-{{ section.id }}\">Colecciones</h2><span class=\"ce-r\" aria-hidden=\"true\"></span></header><div class=\"ce-g\">\n{%- for h in ce_h -%}\n{%- liquid\n  assign c = collections[h]\n  assign img = c.featured_image\n  assign i = forloop.index0\n  assign alt = img.alt\n  if alt == blank\n    assign alt = 'Colección ' | append: c.title | append: ' de Úrsula Privée'\n  endif\n  case forloop.index\n    when 1\n      assign sz = '(min-width:750px) 55vw, 100vw'\n    when 2\n      assign sz = '(min-width:750px) 45vw, 100vw'\n    else\n      assign sz = '(min-width:1400px) 1320px, 100vw'\n  endcase\n  assign tp = c.title | split: '/'\n-%}\n{%- if c.id != blank and img != blank -%}\n<a class=\"ce-i ce-i{{ forloop.index }}\" href=\"{{ c.url }}\" style=\"--p:{{ ce_p[i] }};--pm:{{ ce_pm[i] }}\">{{ img | image_url: width: 1600 | image_tag: widths: '400,600,800,1100,1600', sizes: sz, alt: alt, loading: 'lazy' }}<div class=\"ce-c\"><p class=\"ce-n\" aria-hidden=\"true\">0{{ forloop.index }}<i></i>Colección</p><h3 class=\"ce-t\">{% if tp.size > 1 %}{{ tp[0] | strip }}<em>/&nbsp;{{ tp[1] | strip }}</em>{% else %}{{ c.title }}{% endif %}</h3><span class=\"ce-b\">Descubrir<svg viewBox=\"0 0 24 9\" aria-hidden=\"true\"><path d=\"M0 4.5h22M18.5 1l3.5 3.5L18.5 8\" fill=\"none\" stroke=\"currentColor\"/></svg></span></div></a>\n{%- endif -%}\n{%- endfor -%}\n</div></div></section>\n<style>.ce{--k:#1c1a17;--m:#6f655c;--f:'Cormorant Garamond',Georgia,serif;--e:cubic-bezier(.22,.61,.36,1);padding:clamp(28px,4vw,56px) 0;color:var(--k)}.ce *{box-sizing:border-box}.ce-w{max-width:1320px;margin:0 auto;padding:0 clamp(16px,3vw,48px)}.ce-h{text-align:center;margin-bottom:clamp(20px,3vw,36px)}.ce-e{margin:0 0 8px;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--m)}.ce-h h2{margin:0;font:300 clamp(2.4rem,5vw,4.2rem)/1 var(--f);color:var(--k)}.ce-r{display:block;width:48px;height:1px;margin:14px auto 0;background:var(--k);opacity:.45}.ce-g{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}.ce-i{position:relative;display:block;overflow:hidden;isolation:isolate;border-radius:16px;aspect-ratio:1;background:#efe9e1;color:var(--k);text-decoration:none}.ce-i2{aspect-ratio:4/5}.ce-i img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:var(--pm);transition:transform 1.4s var(--e)}.ce-i:after{content:'';position:absolute;inset:0;background:radial-gradient(110% 65% at 0 100%,rgb(248 245 240/.8),rgb(248 245 240/.35) 40%,transparent 65%);pointer-events:none}.ce-c{position:absolute;left:0;bottom:0;z-index:1;max-width:60%;padding:clamp(16px,2.4vw,32px)}.ce-n{display:flex;align-items:center;gap:10px;margin:0 0 6px;font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:var(--m)}.ce-n i{width:26px;height:1px;background:currentColor;transition:width 1s var(--e)}.ce-t{margin:0;font:400 clamp(1.6rem,6.5vw,2rem)/1 var(--f);color:var(--k)}.ce-t em{display:block;font-weight:300}.ce-b{display:inline-flex;align-items:center;gap:10px;margin-top:12px;padding-bottom:4px;font-size:10px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size .9s var(--e)}.ce-b svg{width:24px;height:9px;transition:transform .9s var(--e)}.ce-i:focus-visible{outline:2px solid var(--k);outline-offset:3px}@media(min-width:750px){.ce-g{grid-template-columns:55fr 45fr;gap:clamp(12px,1.4vw,20px)}.ce-i2{aspect-ratio:auto}.ce-i3{grid-column:1/-1;aspect-ratio:16/9}.ce-i img{object-position:var(--p)}.ce-t{font-size:clamp(1.9rem,3vw,2.5rem)}.ce-c{max-width:50%}}@media(min-width:990px){.ce-i3{aspect-ratio:21/9}}@media(hover:hover){.ce-i:hover img{transform:scale(1.035)}.ce-i:hover .ce-n i{width:44px}.ce-i:hover .ce-b{background-size:100% 1px}.ce-i:hover svg{transform:translateX(5px)}}@media(prefers-reduced-motion:reduce){.ce *{transition:none!important}}</style>"
