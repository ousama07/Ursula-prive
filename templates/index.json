            "custom_liquid": "{%- comment -%}\n  ÚRSULA PRIVÉE · COLECCIONES (carrusel con profundidad)\n  Este comentario lo elimina Shopify antes de enviar la página: no pesa nada.\n\n  ENCUADRE — un valor por colección, en el mismo orden que ce_h:\n    ce_p  → tablet y escritorio · ce_pm → móvil\n    \"horizontal vertical\": 0% izquierda/arriba · 50% centro · 100% derecha/abajo\n  ce_start → posición (empezando en 0) de la colección centrada al cargar.\n  ce_h actualizado 2026-10-26: fuera Giacche (americanas); ropa, calzado, bolsos y joyeria.\n  Completi 3 Pezzi va en la posicion 1, que es la que queda centrada al cargar (ce_start).\n{%- endcomment -%}\n{%- liquid\n  assign ce_h = 'mosaicos|completi-3-pezzi|conjuntos-americanas|vestidos|jerseys|calzado|bolsos|joyeria' | split: '|'\n  assign ce_p = '50% 20%|50% 20%|50% 20%|20% 30%|50% 20%|50% 50%|50% 50%|50% 50%' | split: '|'\n  assign ce_pm = '50% 20%|50% 18%|50% 16%|22% 50%|50% 18%|50% 50%|50% 50%|50% 50%' | split: '|'\n  assign ce_start = 1\n  assign ce_n = 0\n  capture ce_txt\n    echo 'Collezioni'\n    for h in ce_h\n      echo collections[h].title\n    endfor\n  endcapture\n-%}\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&text={{ ce_txt | url_encode }}&display=swap\" media=\"print\" onload=\"this.media='all'\">\n<section class=\"ce\" aria-labelledby=\"ce-h-{{ section.id }}\"><div class=\"ce-w\"><header class=\"ce-h\"><p class=\"ce-e\">Scopri la nostra selezione</p><h2 id=\"ce-h-{{ section.id }}\">Collezioni</h2><span class=\"ce-r\" aria-hidden=\"true\"></span></header><depth-carousel class=\"depth-carousel ce-dc\" data-initial-index=\"{{ ce_start }}\" aria-roledescription=\"carrusel\" aria-label=\"Collezioni\"><div class=\"depth-carousel__stage\">\n{%- for h in ce_h -%}\n{%- liquid\n  assign c = collections[h]\n  assign img = c.featured_image\n  assign i = forloop.index0\n  assign alt = img.alt\n  if alt == blank\n    assign alt = 'Collezione ' | append: c.title | append: ' de Úrsula Privée'\n  endif\n  # La tarjeta es vertical (4:5) y la foto la rellena recortando: una foto horizontal se muestra\n  # mucho más ancha que la tarjeta, así que pedimos al navegador una versión proporcionalmente mayor.\n  assign ce_f = img.aspect_ratio | times: 1.25\n  if ce_f < 1\n    assign ce_f = 1\n  endif\n  assign ce_d = 430 | times: ce_f | ceil\n  assign ce_t = 44 | times: ce_f | ceil\n  assign ce_m = 72 | times: ce_f | ceil\n  assign sz = '(min-width:990px) ' | append: ce_d | append: 'px, (min-width:750px) ' | append: ce_t | append: 'vw, ' | append: ce_m | append: 'vw'\n  assign tp = c.title | split: '/'\n-%}\n{%- if c.id != blank and img != blank -%}\n<div class=\"depth-carousel__slide{% if ce_n == ce_start %} is-active{% endif %}\" data-index=\"{{ ce_n }}\" role=\"group\" aria-roledescription=\"colección\" aria-label=\"{{ c.title | escape }}\"><a class=\"ce-i ce-i{{ forloop.index }}\" href=\"{{ c.url }}\" style=\"--p:{{ ce_p[i] }};--pm:{{ ce_pm[i] }}\">{{ img | image_url: width: 1600 | image_tag: widths: '400,600,800,1100,1600,2200,3000', sizes: sz, alt: alt, loading: 'lazy' }}<div class=\"ce-c\"><p class=\"ce-n\" aria-hidden=\"true\">0{{ forloop.index }}<i></i>Collezione</p><h3 class=\"ce-t\">{% if tp.size > 1 %}{{ tp[0] | strip }}<em>/&nbsp;{{ tp[1] | strip }}</em>{% else %}{{ c.title }}{% endif %}</h3><span class=\"ce-b\">Scopri<svg viewBox=\"0 0 24 9\" aria-hidden=\"true\"><path d=\"M0 4.5h22M18.5 1l3.5 3.5L18.5 8\" fill=\"none\" stroke=\"currentColor\"/></svg></span></div></a></div>\n{%- assign ce_n = ce_n | plus: 1 -%}\n{%- endif -%}\n{%- endfor -%}\n{%- if ce_n > 1 -%}\n<button type=\"button\" class=\"depth-carousel__arrow depth-carousel__arrow--prev\" data-action=\"prev\" aria-label=\"Collezione precedente\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M15 5l-7 7 7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button><button type=\"button\" class=\"depth-carousel__arrow depth-carousel__arrow--next\" data-action=\"next\" aria-label=\"Collezione successiva\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>\n{%- endif -%}\n</div>\n{%- if ce_n > 1 -%}<div class=\"depth-carousel__dots\">{%- for n in (1..ce_n) -%}<button type=\"button\" class=\"depth-carousel__dot\" data-dot=\"{{ forloop.index0 }}\" aria-label=\"{{ n }} / {{ ce_n }}\"></button>{%- endfor -%}</div>{%- endif -%}\n</depth-carousel></div></section>\n<script src=\"{{ 'depth-carousel.js' | asset_url }}\" type=\"module\" defer></script>\n<style>.ce{--k:#1c1a17;--m:#6f655c;--f:'Cormorant Garamond',Georgia,serif;--e:cubic-bezier(.22,.61,.36,1);padding:clamp(28px,4vw,56px) 0;color:var(--k)}.ce *{box-sizing:border-box}.ce-w{max-width:1320px;margin:0 auto;padding:0 clamp(16px,3vw,48px)}.ce-h{text-align:center;margin-bottom:clamp(20px,3vw,36px)}.ce-e{margin:0 0 8px;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--m)}.ce-h h2{margin:0;font:300 clamp(2.4rem,5vw,4.2rem)/1 var(--f);color:var(--k)}.ce-r{display:block;width:48px;height:1px;margin:14px auto 0;background:var(--k);opacity:.45}.ce-g{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}.ce-i{position:relative;display:block;overflow:hidden;isolation:isolate;border-radius:16px;aspect-ratio:1;background:#efe9e1;color:var(--k);text-decoration:none}.ce-i2{aspect-ratio:4/5}.ce-i img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:var(--pm);transition:transform 1.4s var(--e)}.ce-i:after{content:'';position:absolute;inset:0;background:radial-gradient(110% 65% at 0 100%,rgb(248 245 240/.8),rgb(248 245 240/.35) 40%,transparent 65%);pointer-events:none}.ce-c{position:absolute;left:0;bottom:0;z-index:1;max-width:60%;padding:clamp(16px,2.4vw,32px)}.ce-n{display:flex;align-items:center;gap:10px;margin:0 0 6px;font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:var(--m)}.ce-n i{width:26px;height:1px;background:currentColor;transition:width 1s var(--e)}.ce-t{margin:0;font:400 clamp(1.6rem,6.5vw,2rem)/1 var(--f);color:var(--k)}.ce-t em{display:block;font-weight:300}.ce-b{display:inline-flex;align-items:center;gap:10px;margin-top:12px;padding-bottom:4px;font-size:10px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size .9s var(--e)}.ce-b svg{width:24px;height:9px;transition:transform .9s var(--e)}.ce-i:focus-visible{outline:2px solid var(--k);outline-offset:3px}@media(min-width:750px){.ce-g{grid-template-columns:55fr 45fr;gap:clamp(12px,1.4vw,20px)}.ce-i2{aspect-ratio:auto}.ce-i3{grid-column:1/-1;aspect-ratio:16/9}.ce-i img{object-position:var(--p)}.ce-t{font-size:clamp(1.9rem,3vw,2.5rem)}.ce-c{max-width:50%}}@media(min-width:990px){.ce-i3{aspect-ratio:21/9}}@media(hover:hover){.ce-i:hover img{transform:scale(1.035)}.ce-i:hover .ce-n i{width:44px}.ce-i:hover .ce-b{background-size:100% 1px}.ce-i:hover svg{transform:translateX(5px)}}@media(prefers-reduced-motion:reduce){.ce *{transition:none!important}}.ce-dc{--dc-card-w:min(72%,330px);--dc-shift:.6}.ce-dc .depth-carousel__stage{padding-block:8px 24px}.ce-dc .ce-i{width:100%;aspect-ratio:4/5!important;grid-column:auto!important}.ce-dc .ce-i img{object-position:var(--pm)!important}.ce-dc .ce-c{max-width:88%}.ce-dc .ce-t{font-size:clamp(1.6rem,6vw,2.1rem)}.ce-dc .depth-carousel__slide::after{border-radius:16px}.ce-dc .depth-carousel__slide.is-active .ce-i{box-shadow:0 22px 44px -26px rgb(0 0 0/.35),0 6px 14px -10px rgb(0 0 0/.12)}.ce-dc .depth-carousel__slide:not(.is-active) .ce-b{visibility:hidden}@media(max-width:749px){.ce-dc .depth-carousel__stage{margin-inline:calc(-1*(var(--page-margin,16px) + clamp(16px,3vw,48px)))}}.shopify-section:has(.ce-dc){overflow-x:clip}@media(min-width:750px){.ce-dc{--dc-card-w:44%;--dc-shift:.64}}@media(min-width:990px){.ce-dc{--dc-card-w:min(34%,430px);--dc-shift:.68}.ce-dc .ce-t{font-size:clamp(1.9rem,2.4vw,2.4rem)}}@media(hover:hover){.ce-dc .depth-carousel__slide:not(.is-active) .ce-i:hover img{transform:none}}</style>"
