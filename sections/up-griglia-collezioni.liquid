{%- comment -%}
  ÚRSULA PRIVÉE · CUADRICULA DE COLECCIONES (para paginas)
  Se usa en las paginas Uomo y Donna: una rejilla de colecciones, cada una
  con su foto y su nombre en una etiqueta blanca centrada. Al pulsar una
  tarjeta se abre la pagina real de esa coleccion.

  Las colecciones se eligen en el editor de temas (ajuste "Collezioni").
  Si una coleccion no tiene foto propia se usa la del primer producto.
{%- endcomment -%}

{%- liquid
  assign ugc_set = section.settings.collections
  assign ugc_ratio = '4 / 5'
  if section.settings.image_ratio == 'square'
    assign ugc_ratio = '1 / 1'
  endif

  capture ugc_txt
    echo section.settings.heading
    echo section.settings.eyebrow
  endcapture
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&text={{ ugc_txt | url_encode }}&display=swap" media="print" onload="this.media='all'">

<section class="ugc" id="ugc-{{ section.id }}" aria-labelledby="ugch-{{ section.id }}">
  <div class="ugc-w">

    <header class="ugc-h">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ugc-e">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 id="ugch-{{ section.id }}">{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="ugc-i">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- if ugc_set.size > 0 -%}
      <div class="ugc-grid">
        {%- for c in ugc_set -%}
          {%- liquid
            assign ci = c.image
            if ci == blank
              assign cp = c.products | first
              assign ci = cp.featured_image
            endif
          -%}
          <a class="ugc-card" href="{{ c.url }}">
            <span class="ugc-card__media">
              {%- if ci != blank -%}
                {{ ci | image_url: width: 800 | image_tag: alt: '', loading: 'lazy', widths: '320,480,640,800', sizes: '(min-width:990px) 320px, (min-width:750px) 32vw, 46vw' }}
              {%- endif -%}
            </span>
            <span class="ugc-card__tag">{{ c.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="ugc-empty">Nessuna collezione disponibile al momento.</p>
    {%- endif -%}

  </div>
</section>

<style>
#ugc-{{ section.id }}{--k:#1c1a17;--m:#6f655c;--line:#e3dbd0;--f:'Cormorant Garamond',Georgia,serif;--e:cubic-bezier(.22,.61,.36,1);--ratio:{{ ugc_ratio }}}
.ugc{display:block;width:100%;max-width:100vw;padding:clamp(24px,3.4vw,52px) 0 clamp(36px,5vw,76px);color:var(--k)}
.ugc *{box-sizing:border-box}
.ugc-w{max-width:1320px;margin:0 auto;padding:0 clamp(16px,3vw,48px)}
.ugc-h{margin:0 0 clamp(18px,2.6vw,34px)}
.ugc-e{display:flex;align-items:center;gap:12px;margin:0 0 10px;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--m)}
.ugc-e:before{content:'';width:28px;height:1px;background:currentColor}
.ugc-h h1{margin:0;font:300 clamp(2rem,5vw,3.4rem)/1.05 var(--f);letter-spacing:.04em;text-transform:uppercase;text-wrap:balance}
.ugc-i{margin:14px 0 0;max-width:56ch;font-size:15px;line-height:1.7;color:#4a433d}
.ugc-i p{margin:0}
.ugc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(10px,1.4vw,18px)}
@media(min-width:750px){.ugc-grid{grid-template-columns:repeat(3,1fr)}}
@media(min-width:990px){.ugc-grid{grid-template-columns:repeat(4,1fr)}}
.ugc-card{position:relative;display:block;width:100%;aspect-ratio:var(--ratio);border-radius:12px;overflow:hidden;background:#efe9e1;color:var(--k);text-decoration:none}
.ugc-card__media,.ugc-card__media img{display:block;width:100%;height:100%;object-fit:cover}
.ugc-card__tag{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);max-width:86%;padding:10px 16px;background:#fff;color:var(--k);font-size:clamp(12px,1.5vw,15px);line-height:1.25;text-align:center;box-shadow:0 2px 12px rgb(28 26 23/.14)}
.ugc-card:focus-visible{outline:2px solid var(--k);outline-offset:3px}
.ugc-empty{margin:0;font-size:14px;color:var(--m)}
@media(hover:hover){.ugc-card img{transition:transform .6s var(--e)}.ugc-card:hover img{transform:scale(1.04)}.ugc-card:hover .ugc-card__tag{box-shadow:0 4px 18px rgb(28 26 23/.2)}}
@media(prefers-reduced-motion:reduce){.ugc *{transition:none!important}}
</style>

{% schema %}
{
  "name": "Cuadricula de colecciones",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetitulo" },
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Collezione" },
    { "type": "richtext", "id": "intro", "label": "Texto de introduccion (opcional)" },
    { "type": "collection_list", "id": "collections", "label": "Collezioni", "limit": 20 },
    {
      "type": "select", "id": "image_ratio", "label": "Forma de las fotos", "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Vertical 4:5" },
        { "value": "square", "label": "Cuadrada 1:1" }
      ]
    }
  ],
  "presets": [{ "name": "Cuadricula de colecciones" }]
}
{% endschema %}
