{%- comment -%}
  ÚRSULA PRIVÉE · COMPLETA TU OUTFIT
  Carrusel de bolsos y calzado bajo "También te puede gustar".
  Usa los mismos estilos y la misma tarjeta de producto que las
  recomendaciones, para que se vea nativo. Rota el punto de partida
  cada hora para que no salgan siempre los mismos.
{%- endcomment -%}

{% liquid
  # ÚRSULA PRIVÉE · "Completa il tuo outfit"
  # Antes se hacia collection_a.products | concat: collection_b.products.
  # concat no funciona sobre el listado de productos de una coleccion
  # (no es un array normal), asi que la lista salia vacia y el carrusel
  # aparecia sin ninguna tarjeta. Ahora se recorre cada coleccion por
  # separado con offset/limit, que si admite.
  assign up_ca = section.settings.collection_a
  assign up_cb = section.settings.collection_b

  assign up_half = section.settings.max_products | divided_by: 2
  if up_half < 1
    assign up_half = 1
  endif

  # Rotacion por hora para que no salgan siempre los mismos.
  # El rango se calcula para que offset + limit nunca pase del total.
  assign up_hour = 'now' | date: '%H' | times: 1
  assign up_oa = 0
  assign up_ob = 0
  if up_ca.products_count > up_half
    assign up_ra = up_ca.products_count | minus: up_half | plus: 1
    assign up_oa = up_hour | times: up_half | modulo: up_ra
  endif
  if up_cb.products_count > up_half
    assign up_rb = up_cb.products_count | minus: up_half | plus: 1
    assign up_ob = up_hour | times: up_half | modulo: up_rb
  endif

  capture up_styles
    echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--resource-list-row-gap-desktop: ' | append: section.settings.rows_gap | append: 'px;'
    echo '--resource-list-columns: repeat(' | append: section.settings.columns | append: ', 1fr);'
    echo '--resource-list-columns-mobile: repeat(' | append: section.settings.mobile_columns | append: ', 1fr);'
    echo '--column-count: ' | append: section.settings.columns | append: ';'
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
  endcapture
%}

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'quantity-selector-styles' %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}
{% render 'resource-list-styles' %}

<div class="up-outfit" {{ section.shopify_attributes }}>
  <div class="section-background"></div>
  <div
    class="section section--{{ section.settings.section_width }} section-resource-list spacing-style gap-style"
    style="
      {% render 'spacing-style', settings: section.settings %}
      {% render 'gap-style', value: section.settings.gap %}
      {{ up_styles }}
    "
  >
    <div class="section-resource-list__content">
      {% content_for 'blocks' %}
    </div>

    {% capture up_items %}
      {%- liquid
        assign up_seen = ','
        assign up_current = closest.product | default: product
        if up_current != blank
          assign up_seen = up_seen | append: up_current.id | append: ','
        endif
        assign up_n = 0
      -%}
      {% for up_p in up_ca.products offset: up_oa limit: up_half %}
        {%- assign up_key = ',' | append: up_p.id | append: ',' -%}
        {%- unless up_seen contains up_key -%}
          {%- if up_n > 0 %}<!--@list/split-->{% endif -%}
          {%- assign up_seen = up_seen | append: up_p.id | append: ',' -%}
          {%- assign up_n = up_n | plus: 1 -%}
          <div class="resource-list__item">
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: up_p,
              product_view_context: 'recommendation'
            %}
          </div>
        {%- endunless -%}
      {% endfor %}
      {% for up_p in up_cb.products offset: up_ob limit: up_half %}
        {%- assign up_key = ',' | append: up_p.id | append: ',' -%}
        {%- unless up_seen contains up_key -%}
          {%- if up_n > 0 %}<!--@list/split-->{% endif -%}
          {%- assign up_seen = up_seen | append: up_p.id | append: ',' -%}
          {%- assign up_n = up_n | plus: 1 -%}
          <div class="resource-list__item">
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: up_p,
              product_view_context: 'recommendation'
            %}
          </div>
        {%- endunless -%}
      {% endfor %}
    {% endcapture %}

    {% liquid
      assign up_content = up_items | strip
      assign up_slides = up_content | split: '<!--@list/split-->'
    %}

    {%- if up_slides.size > 0 and up_content != blank -%}
      <div class="resource-list force-full-width resource-list__carousel">
        {% render 'resource-list-carousel',
          ref: 'upOutfitCarousel',
          slides: up_slides,
          slide_count: up_slides.size,
          settings: section.settings
        %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{ "name": "Completa tu outfit", "blocks": [{ "type": "@theme" }, { "type": "text" }], "settings": [
  { "type": "collection", "id": "collection_a", "label": "A" },
  { "type": "collection", "id": "collection_b", "label": "B" },
  { "type": "range", "id": "max_products", "label": "N", "min": 3, "max": 24, "step": 1, "default": 16 },
  { "type": "range", "id": "columns", "label": "C", "min": 1, "max": 8, "step": 1, "default": 4 },
  { "type": "select", "id": "mobile_columns", "label": "M", "options": [{ "value": "2", "label": "2" }], "default": "2" },
  { "type": "range", "id": "columns_gap", "label": "H", "min": 0, "max": 100, "step": 1, "default": 12 },
  { "type": "range", "id": "rows_gap", "label": "V", "min": 0, "max": 100, "step": 1, "default": 24 },
  { "type": "select", "id": "icons_style", "label": "I", "options": [{ "value": "arrow", "label": "A" }], "default": "arrow" },
  { "type": "select", "id": "icons_shape", "label": "F", "options": [{ "value": "none", "label": "N" }], "default": "none" },
  { "type": "select", "id": "section_width", "label": "W", "options": [{ "value": "page-width", "label": "P" }], "default": "page-width" },
  { "type": "range", "id": "gap", "label": "G", "min": 0, "max": 100, "step": 1, "default": 28 },
  { "type": "range", "id": "padding-block-start", "label": "T", "min": 0, "max": 100, "step": 1, "default": 56 },
  { "type": "range", "id": "padding-block-end", "label": "B", "min": 0, "max": 100, "step": 1, "default": 72 }
] }
{% endschema %}