<div class="up-outfit" {{ section.shopify_attributes }}>
  <div class="section section--page-width">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Completa tu outfit",
  "blocks": [
    { "type": "@theme" },
    { "type": "text" }
  ],
  "settings": [
    { "type": "collection", "id": "collection_a", "label": "Primera coleccion" },
    { "type": "collection", "id": "collection_b", "label": "Segunda coleccion" },
    { "type": "range", "id": "max_products", "label": "Numero de productos", "min": 3, "max": 24, "step": 1, "default": 16 },
    { "type": "range", "id": "columns", "label": "Columnas", "min": 1, "max": 8, "step": 1, "default": 4 },
    { "type": "select", "id": "mobile_columns", "label": "Columnas en movil", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "columns_gap", "label": "Separacion horizontal", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "rows_gap", "label": "Separacion vertical", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24 },
    { "type": "select", "id": "icons_style", "label": "Flechas", "options": [{ "value": "none", "label": "Ninguna" }, { "value": "arrow", "label": "Flecha" }], "default": "arrow" },
    { "type": "select", "id": "icons_shape", "label": "Forma", "options": [{ "value": "none", "label": "Ninguna" }, { "value": "circle", "label": "Circulo" }], "default": "none" },
    { "type": "select", "id": "section_width", "label": "Ancho", "options": [{ "value": "page-width", "label": "Pagina" }, { "value": "full-width", "label": "Completo" }], "default": "page-width" },
    { "type": "range", "id": "gap", "label": "Separacion", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding-block-start", "label": "Margen superior", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-block-end", "label": "Margen inferior", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 72 }
  ]
}
{% endschema %}
