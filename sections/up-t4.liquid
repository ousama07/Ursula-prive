<div class="up-outfit" {{ section.shopify_attributes }}>
  <div class="section section--page-width">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "T4",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection_a",
      "label": "Primera colección"
    },
    {
      "type": "collection",
      "id": "collection_b",
      "label": "Segunda colección"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Número de productos",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columnas en móvil",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Separación horizontal",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Separación vertical",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Flechas",
      "options": [
        {
          "value": "none",
          "label": "Ninguna"
        },
        {
          "value": "arrow",
          "label": "Flecha"
        },
        {
          "value": "chevron",
          "label": "Chevrón"
        },
        {
          "value": "caret",
          "label": "Punta"
        },
        {
          "value": "plus",
          "label": "Más"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Forma de las flechas",
      "options": [
        {
          "value": "none",
          "label": "Ninguna"
        },
        {
          "value": "circle",
          "label": "Círculo"
        },
        {
          "value": "square",
          "label": "Cuadrado"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        {
          "value": "page-width",
          "label": "Ancho de página"
        },
        {
          "value": "full-width",
          "label": "Ancho completo"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Separación",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Margen superior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Margen inferior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}