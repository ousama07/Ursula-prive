</div>

{% schema %}
{
  "name": "T5",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "text"
    }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection_a",
      "label": "A"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "G",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 28,
      "unit": "px"
    }
  ]
}
{% endschema %}
