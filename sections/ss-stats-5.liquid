>
  <div class="section-{{ section.id }}-settings">
    <div class="stats-top-{{ section.id }}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            {% if block.settings.heading != blank %}
              <div class="stats-heading-{{ block.id }}">
                {{ block.settings.heading }}
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>

    <div class="stats-grid-{{ section.id }} {% if enable_slider_mobile %}is-slider js-slider-{{ section.id }}{% endif %}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'feature' %}
            <div class="stats-card-{{ section.id }}">
              <div class="stats-percent-wrap-{{ section.id }}">
                <span
                  class="stats-percent-num-{{ section.id }} js-percent-num-{{ section.id }}"
                  data-target="{{ block.settings.percent | default: 0 }}"
                >
                  {%- if enable_animation %}0{% else %}{{ block.settings.percent | default: 0 }}{% endif -%}</span
                ><span class="stats-percent-suffix-{{ section.id }}">%</span>
              </div>
              <div class="stats-bar-wrap-{{ section.id }}">
                <div class="stats-bar-bg-{{ section.id }}"></div>
                <div
                  class="stats-bar-fill-{{ section.id }} js-bar-fill-{{ section.id }}"
                  data-target="{{ block.settings.percent | default: 0 }}"
                  {% unless enable_animation %}
                    style="width: {{ block.settings.percent | default: 0 }}%;"
                  {% endunless %}
                ></div>
              </div>
              {% if block.settings.heading != blank %}
                <div class="stats-card-heading-{{ section.id }}">
                  {{ block.settings.heading }}
                </div>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="stats-card-text-{{ section.id }}">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    {% if enable_slider_mobile %}
      <div class="stats-slider-dots-{{ section.id }}">
        {% assign feature_blocks = section.blocks | where: 'type', 'feature' %}
        {% for block in feature_blocks %}
          <button
            class="stats-dot-{{ section.id }} js-dot-{{ section.id }} {% if forloop.first %}is-active{% endif %}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  function initStats5() {
    var section = document.querySelector('.section-{{ section.id }}');
    if (!section) return;

    var nums = section.querySelectorAll('.js-percent-num-{{ section.id }}');
    var bars = section.querySelectorAll('.js-bar-fill-{{ section.id }}');

    if (!nums.length) return;

    {% if enable_animation %}
    if (section._f55Observer) {
      section._f55Observer.disconnect();
      section._f55Observer = null;
    }
    if (section._f55Raf) {
      cancelAnimationFrame(section._f55Raf);
      section._f55Raf = null;
    }

    nums.forEach(function(n) { n.textContent = '0'; });
    bars.forEach(function(b) {
      b.style.transition = 'none';
      b.style.width = '0%';
    });

    var isMobile = window.innerWidth < 1024;
    var DURATION = (isMobile ? {{ animation_duration_mobile }} : {{ animation_duration }}) * 1000;

    var targets = Array.from(nums).map(function(el) {
      return {
        el: el,
        target: parseInt(el.dataset.target, 10) || 0
      };
    });

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;

        observer.disconnect();

        bars.forEach(function(b) {
          b.offsetHeight;
          b.style.transition = 'width ' + DURATION + 'ms linear';
          b.style.width = b.dataset.target + '%';
        });

        var startTime = null;

        function animate(currentTime) {
          if (!startTime) startTime = currentTime;
          var elapsed = currentTime - startTime;
          var progress = Math.min(elapsed / DURATION, 1);

          targets.forEach(function(t) {
            t.el.textContent = Math.round(t.target * progress);
          });

          if (progress < 1) {
            section._f55Raf = requestAnimationFrame(animate);
          } else {
            targets.forEach(function(t) {
              t.el.textContent = t.target;
            });
            section._f55Raf = null;
          }
        }

        section._f55Raf = requestAnimationFrame(animate);
      });
    }, { threshold: 0.3 });

    observer.observe(section);
    section._f55Observer = observer;
    {% endif %}

    var slider = section.querySelector('.js-slider-{{ section.id }}');
    var dots = section.querySelectorAll('.js-dot-{{ section.id }}');

    if (slider && dots.length > 0) {
      var updateDots = function() {
        var scrollLeft = slider.scrollLeft;
        var firstCard = slider.querySelector('.stats-card-{{ section.id }}');
        if (!firstCard) return;
        var itemWidth = firstCard.offsetWidth + {{ features_gap_mobile }};
        var index = Math.round(scrollLeft / itemWidth);
        dots.forEach(function(dot, i) {
          if (i === index) {
            dot.classList.add('is-active');
          } else {
            dot.classList.remove('is-active');
          }
        });
      };

      slider.addEventListener('scroll', updateDots, { passive: true });

      dots.forEach(function(dot, i) {
        dot.addEventListener('click', function() {
          var firstCard = slider.querySelector('.stats-card-{{ section.id }}');
          if (!firstCard) return;
          var itemWidth = firstCard.offsetWidth + {{ features_gap_mobile }};
          slider.scrollTo({
            left: i * itemWidth,
            behavior: 'smooth'
          });
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStats5);
  } else {
    initStats5();
  }

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', function(event) {
      if (event.detail.sectionId !== '{{ section.id }}') return;
      var section = document.querySelector('.section-{{ section.id }}');
      if (!section) return;
      if (section._f55Observer) { section._f55Observer.disconnect(); section._f55Observer = null; }
      if (section._f55Raf) { cancelAnimationFrame(section._f55Raf); section._f55Raf = null; }
    });
    document.addEventListener('shopify:section:load', initStats5);
  }
</script>{%- elsif request.design_mode -%}
