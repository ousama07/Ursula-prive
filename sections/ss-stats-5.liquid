{% schema %}
{
  "name": "SS - Stats #5",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "features_columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_slider_mobile",
      "label": "Enable slider on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "features_columns_mobile",
      "label": "Columns - mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1",
      "visible_if": "{{ section.settings.enable_slider_mobile == false }}"
    },
    {
      "type": "checkbox",
      "id": "grid_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "features_gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap",
      "default": 16,
      "visible_if": "{{ section.settings.grid_advanced }}"
    },
    {
      "type": "range",
      "id": "features_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap - mobile",
      "default": 16,
      "visible_if": "{{ section.settings.grid_advanced }}"
    },
    {
      "type": "range",
      "id": "features_mt",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 36,
      "visible_if": "{{ section.settings.grid_advanced }}"
    },
    {
      "type": "range",
      "id": "features_mt_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top - mobile",
      "default": 24,
      "visible_if": "{{ section.settings.grid_advanced }}"
    },
    {
      "type": "header",
      "content": "Feature card"
    },
    {
      "type": "checkbox",
      "id": "feature_shadow",
      "label": "Enable shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "feature_padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "feature_padding_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding - mobile",
      "default": 20
    },
    {
      "type": "range",
      "id": "feature_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Roundness",
      "default": 12
    },
    {
      "type": "range",
      "id": "feature_border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1
    },
    {
      "type": "text_alignment",
      "id": "feature_align",
      "label": "Alignment"
    },
    {
      "type": "text_alignment",
      "id": "feature_align_mobile",
      "label": "Alignment - mobile"
    },
    {
      "type": "header",
      "content": "Percent"
    },
    {
      "type": "checkbox",
      "id": "percent_custom",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "percent_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.percent_custom }}"
    },
    {
      "type": "range",
      "id": "percent_size",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 56
    },
    {
      "type": "range",
      "id": "percent_size_mobile",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 40
    },
    {
      "type": "range",
      "id": "percent_suffix_size",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Suffix (%) size",
      "default": 20
    },
    {
      "type": "range",
      "id": "percent_suffix_size_mobile",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Suffix (%) size - mobile",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "percent_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "percent_height",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "Line height",
      "default": 130,
      "visible_if": "{{ section.settings.percent_advanced }}"
    },
    {
      "type": "header",
      "content": "Progress bar"
    },
    {
      "type": "range",
      "id": "bar_height",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Height",
      "default": 4
    },
    {
      "type": "range",
      "id": "bar_radius",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Roundness",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "bar_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "bar_mt",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margin top",
      "default": 8,
      "visible_if": "{{ section.settings.bar_advanced }}"
    },
    {
      "type": "range",
      "id": "bar_mt_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margin top - mobile",
      "default": 8,
      "visible_if": "{{ section.settings.bar_advanced }}"
    },
    {
      "type": "header",
      "content": "Feature heading"
    },
    {
      "type": "checkbox",
      "id": "feature_heading_custom",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "feature_heading_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.feature_heading_custom }}"
    },
    {
      "type": "range",
      "id": "feature_heading_size",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "feature_heading_size_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "feature_heading_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "feature_heading_height",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "Line height",
      "default": 130,
      "visible_if": "{{ section.settings.feature_heading_advanced }}"
    },
    {
      "type": "range",
      "id": "feature_heading_mt",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margin top",
      "default": 12,
      "visible_if": "{{ section.settings.feature_heading_advanced }}"
    },
    {
      "type": "range",
      "id": "feature_heading_mt_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margin top - mobile",
      "default": 10,
      "visible_if": "{{ section.settings.feature_heading_advanced }}"
    },
    {
      "type": "header",
      "content": "Feature text"
    },
    {
      "type": "checkbox",
      "id": "feature_text_custom",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "feature_text_font",
      "label": "Font family",
      "default": "josefin_sans_n4",
      "visible_if": "{{ section.settings.feature_text_custom }}"
    },
    {
      "type": "range",
      "id": "feature_text_size",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "feature_text_size_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font size - mobile",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "feature_text_advanced",
      "label": "Show advanced settings",
      "default": false
    },
    {
      "type": "range",
      "id": "feature_text_height",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "Line height",
      "default": 150,
      "visible_if": "{{ section.settings.feature_text_advanced }}"
    },
    {
      "type": "range",
      "id": "feature_text_mt",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margin top",
      "default": 8,
      "visible_if": "{{ section.settings.feature_text_advanced }}"
    },
    {
      "type": "range",
      "id": "feature_text_mt_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margin top - mobile",
      "default": 6,
      "visible_if": "{{ section.settings.feature_text_advanced }}"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable animation",
      "default": true
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Duration",
      "default": 2,
      "visible_if": "{{ section.settings.enable_animation }}"
    },
    {
      "type": "range",
      "id": "animation_duration_mobile",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Duration - mobile",
      "default": 2,
      "visible_if": "{{ section.settings.enable_animation }}"
    },
    {
      "type": "header",
      "content": "Feature colors"
    },
    {
      "type": "color",
      "label": "Percent number",
      "id": "percent_color",
      "default": "#121212"
    },
    {
      "type": "color",
      "label": "Percent suffix (%)",
      "id": "percent_suffix_color",
      "default": "#121212"
    },
    {
      "type": "color",
      "label": "Bar fill",
      "id": "bar_color",
      "default": "#121212"
    },
    {
      "type": "color",
      "label": "Bar background",
      "id": "bar_bg_color",
      "default": "#F3F3F3"
    },
    {
      "type": "color",
      "label": "Heading",
      "id": "feature_heading_color",
      "default": "#121212"
    },
    {
      "type": "color",
      "label": "Text",
      "id": "feature_text_color",
      "default": "#555555"
    },
    {
      "type": "color",
      "label": "Card background",
      "id": "feature_bg_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "label": "Card border",
      "id": "feature_border_color",
      "default": "#E0E0E0",
      "visible_if": "{{ section.settings.feature_border_thickness > 0 }}"
    },
    {
      "type": "color",
      "label": "Slider dots",
      "id": "dot_color",
      "default": "#D1D5DB",
      "visible_if": "{{ section.settings.enable_slider_mobile }}"
    },
    {
      "type": "color",
      "label": "Slider dots (active)",
      "id": "dot_active_color",
      "default": "#121212",
      "visible_if": "{{ section.settings.enable_slider_mobile }}"
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "default": "solid",
      "options": [
        { "label": "Solid", "value": "solid" },
        { "label": "Gradient", "value": "gradient" }
      ]
    },
    {
      "type": "color",
      "label": "Background",
      "id": "background_color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.background_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Gradient",
      "default": "linear-gradient(180deg, #FFFFFF 0%, #F2F2F2 100%)",
      "visible_if": "{{ section.settings.background_style == 'gradient' }}"
    },
    {
      "type": "color",
      "label": "Border",
      "id": "border_color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Section margin (outside)"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_horizontal",
      "min": 0,
      "max": 30,
      "step": 0.5,
      "unit": "rem",
      "label": "Sides",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_horizontal_mobile",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "unit": "rem",
      "label": "Sides - mobile",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section padding (inside)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 30,
      "step": 0.5,
      "unit": "rem",
      "label": "Sides",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "unit": "rem",
      "label": "Sides - mobile",
      "default": 1.5
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "page",
      "options": [
        { "label": "Page", "value": "page" },
        { "label": "Full", "value": "full" },
        { "label": "Custom", "value": "custom" }
      ]
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 800,
      "max": 2000,
      "step": 100,
      "unit": "px",
      "label": "Content width",
      "default": 1200,
      "visible_if": "{{ section.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Roundness",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "limit": 1,
      "name": "Heading",
      "settings": [
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading",
          "default": "<h2>Our results <strong>in numbers</strong></h2>",
          "info": "Highlight text and click 𝗕 to apply the accent color."
        },
        {
          "type": "checkbox",
          "id": "heading_custom",
          "label": "Use custom font",
          "default": false
        },
        {
          "type": "font_picker",
          "id": "heading_font",
          "label": "Font family",
          "default": "josefin_sans_n4",
          "visible_if": "{{ block.settings.heading_custom }}"
        },
        {
          "type": "range",
          "id": "heading_size",
          "min": 0,
          "max": 72,
          "step": 2,
          "unit": "px",
          "label": "Font size",
          "default": 40
        },
        {
          "type": "range",
          "id": "heading_size_mobile",
          "min": 0,
          "max": 72,
          "step": 2,
          "unit": "px",
          "label": "Font size - mobile",
          "default": 28
        },
        {
          "type": "checkbox",
          "id": "heading_advanced",
          "label": "Show advanced settings",
          "default": false
        },
        {
          "type": "range",
          "id": "heading_height",
          "min": 50,
          "max": 200,
          "step": 5,
          "unit": "%",
          "label": "Line height",
          "default": 130,
          "visible_if": "{{ block.settings.heading_advanced }}"
        },
        {
          "type": "range",
          "id": "heading_mt",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Margin top",
          "default": 0,
          "visible_if": "{{ block.settings.heading_advanced }}"
        },
        {
          "type": "range",
          "id": "heading_mt_mobile",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Margin top - mobile",
          "default": 0,
          "visible_if": "{{ block.settings.heading_advanced }}"
        },
        {
          "type": "text_alignment",
          "id": "content_align",
          "label": "Alignment",
          "default": "center"
        },
        {
          "type": "text_alignment",
          "id": "content_align_mobile",
          "label": "Alignment - mobile",
          "default": "center"
        },
        {
          "type": "range",
          "id": "heading_max_width",
          "min": 200,
          "max": 1600,
          "step": 20,
          "unit": "px",
          "label": "Max width",
          "default": 1200
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "label": "Color",
          "id": "heading_color",
          "default": "#121212"
        },
        {
          "type": "select",
          "id": "heading_accent_color_type",
          "label": "Accent type",
          "default": "solid",
          "options": [
            { "label": "Solid", "value": "solid" },
            { "label": "Gradient", "value": "gradient" }
          ]
        },
        {
          "type": "color",
          "label": "Accent color",
          "id": "heading_accent_color",
          "default": "#808080",
          "visible_if": "{{ block.settings.heading_accent_color_type == 'solid' }}"
        },
        {
          "type": "color_background",
          "id": "heading_accent_gradient",
          "label": "Accent gradient",
          "default": "linear-gradient(135deg, #121212 0%, #808080 100%)",
          "visible_if": "{{ block.settings.heading_accent_color_type == 'gradient' }}"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "range",
          "id": "percent",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Percent",
          "default": 75
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading",
          "default": "<h3>Performance boost</h3>"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A short description explaining this metric to your customers.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS - Stats #5",
      "blocks": [
        { "type": "heading" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
{%- liquid
  assign enable_section = shop.metafields['app--6564759--section_store'].plus_active
-%}
{%- if enable_section -%}{% comment %}
