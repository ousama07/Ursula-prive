{%- style -%}
  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ margin_horizontal_mobile }}rem;
    margin-right: {{ margin_horizontal_mobile }}rem;
    border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
    overflow: hidden;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .stats-top-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ content_horizontal_align_mobile }};
  }

  .stats-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ features_columns_mobile }}, 1fr);
    gap: {{ features_gap_mobile }}px;
    margin-top: {{ features_mt_mobile }}px;
  }

  {% if enable_slider_mobile %}
  @media(max-width: 1023px) {
    .stats-grid-{{ section.id }}.is-slider {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: {{ padding_horizontal_mobile }}rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      margin-left: -{{ padding_horizontal_mobile }}rem;
      margin-right: -{{ padding_horizontal_mobile }}rem;
      padding-left: {{ padding_horizontal_mobile }}rem;
      padding-right: {{ padding_horizontal_mobile }}rem;
      padding-top: 20px;
      padding-bottom: 20px;
      margin-top: calc({{ features_mt_mobile }}px - 20px);
      margin-bottom: -20px;
    }
    .stats-grid-{{ section.id }}.is-slider::-webkit-scrollbar {
      display: none;
    }
    .stats-grid-{{ section.id }}.is-slider .stats-card-{{ section.id }} {
      flex: 0 0 auto;
      width: calc((100% - ({{ features_gap_mobile }}px * {{ mobile_gaps }})) / {{ slider_items_mobile }});
      scroll-snap-align: start;
    }
    .stats-slider-dots-{{ section.id }} {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
    }
    .stats-dot-{{ section.id }} {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: {{ dot_color }};
      transition: background-color 0.3s ease;
      padding: 0;
      border: none;
      cursor: pointer;
      -webkit-appearance: none;
    }
    .stats-dot-{{ section.id }}.is-active {
      background-color: {{ dot_active_color }};
    }
  }
  {% endif %}
  @media(min-width: 1024px) {
    .stats-slider-dots-{{ section.id }} {
      display: none;
    }
  }

  .stats-card-{{ section.id }} {
    display: flex;
    flex-direction: column;
    padding: {{ feature_padding_mobile }}px;
    border-radius: {{ feature_radius }}px;
    border: {{ feature_border_thickness }}px solid {{ feature_border_color }};
    background: {{ feature_bg_color }};
    {% if feature_shadow %}
      box-shadow: rgba(17, 17, 26, 0.1) 0px 0px 16px;
    {% endif %}
  }

  .stats-percent-wrap-{{ section.id }} {
    display: flex;
    align-items: baseline;
    gap: 2px;
    justify-content: {{ feature_horizontal_align_mobile }};
    width: 100%;
  }

  .stats-percent-num-{{ section.id }} {
    font-size: {{ percent_size_mobile }}px;
    color: {{ percent_color }};
    font-weight: 700;
    line-height: {{ percent_height }}%;
    font-variant-numeric: tabular-nums;
  }

  .stats-percent-suffix-{{ section.id }} {
    font-size: {{ percent_suffix_size_mobile }}px;
    color: {{ percent_suffix_color }};
    font-weight: 700;
  }

  .stats-bar-wrap-{{ section.id }} {
    position: relative;
    margin-top: {{ bar_mt_mobile }}px;
    height: {{ bar_height }}px;
    border-radius: {{ bar_radius }}px;
    overflow: hidden;
  }

  .stats-bar-bg-{{ section.id }} {
    display: block !important;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: {{ bar_bg_color }};
  }

  .stats-bar-fill-{{ section.id }} {
    display: block !important;
    position: relative;
    z-index: 1;
    height: 100%;
    width: 0%;
    background-color: {{ bar_color }};
    border-radius: {{ bar_radius }}px;
  }

  .stats-card-heading-{{ section.id }} {
    margin-top: {{ feature_heading_mt_mobile }}px;
    text-align: {{ feature_align_mobile }};
  }

  .stats-card-heading-{{ section.id }} * {
    margin: 0;
    font-size: {{ feature_heading_size_mobile }}px;
    color: {{ feature_heading_color }};
    font-weight: 700;
    line-height: {{ feature_heading_height }}%;
    text-transform: unset;
    text-decoration: none;
    word-break: break-word;
  }

  .stats-card-text-{{ section.id }} {
    margin-top: {{ feature_text_mt_mobile }}px;
    text-align: {{ feature_align_mobile }};
  }

  .stats-card-text-{{ section.id }} * {
    margin: 0;
    font-size: {{ feature_text_size_mobile }}px;
    color: {{ feature_text_color }};
    line-height: {{ feature_text_height }}%;
    text-transform: unset;
    text-decoration: none;
    word-break: break-word;
  }

  @media(min-width: 1024px) {

    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      margin-left: {{ margin_horizontal }}rem;
      margin-right: {{ margin_horizontal }}rem;
      border-radius: {{ section_radius }}px;
    }

    .section-{{ section.id }}-settings {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .stats-top-{{ section.id }} {
      align-items: {{ content_horizontal_align }};
    }

    .stats-grid-{{ section.id }} {
      grid-template-columns: repeat({{ features_columns }}, 1fr);
      gap: {{ features_gap }}px;
      margin-top: {{ features_mt }}px;
    }

    .stats-card-{{ section.id }} {
      padding: {{ feature_padding }}px;
    }

    .stats-percent-wrap-{{ section.id }} {
      justify-content: {{ feature_horizontal_align }};
    }

    .stats-percent-num-{{ section.id }} {
      font-size: {{ percent_size }}px;
    }

    .stats-percent-suffix-{{ section.id }} {
      font-size: {{ percent_suffix_size }}px;
    }

    .stats-bar-wrap-{{ section.id }} {
      margin-top: {{ bar_mt }}px;
    }

    .stats-card-heading-{{ section.id }} {
      margin-top: {{ feature_heading_mt }}px;
      text-align: {{ feature_align }};
    }

    .stats-card-heading-{{ section.id }} * {
      font-size: {{ feature_heading_size }}px;
    }

    .stats-card-text-{{ section.id }} {
      margin-top: {{ feature_text_mt }}px;
      text-align: {{ feature_align }};
    }

    .stats-card-text-{{ section.id }} * {
      font-size: {{ feature_text_size }}px;
    }

  }
{%- endstyle -%}

