{% liquid
  assign up_all = section.settings.collection_a.products
%}
<div class="up-outfit" {{ section.shopify_attributes }}>
  {% for up_p in up_all limit: 4 %}
    <div class="resource-list__item">
      {% content_for 'block',
        type: '_product-card',
        id: 'static-product-card',
        closest.product: up_p,
        product_view_context: 'recommendation'
      %}
    </div>
  {% endfor %}
</div>
{% schema %}
{ "name": "T1", "blocks": [{ "type": "@theme" }], "settings": [{ "type": "collection", "id": "collection_a", "label": "A" }] }
{% endschema %}
