      "settings": {
        "custom_liquid": "{%- unless template.name == 'index' -%}<style>.header-logo__image{filter:brightness(0)}</style>{%- endunless -%}\n<style>\n/* Pie de pagina: fondo negro y letras blancas.\n   El fondo lo pone el ajuste de color de las secciones \"footer\" y\n   \"utilities\" (#000000). Aqui solo forzamos el blanco puro del texto,\n   porque el contraste automatico del tema elige el tono mas claro de la\n   paleta (un crema), no el blanco. */\n.footer-content,.utilities{\n  --color:#fff;--color-rgb:255 255 255;\n  --color-foreground:#fff;--color-foreground-rgb:255 255 255;\n  --color-foreground-muted:rgb(255 255 255 / .75);\n  --color-foreground-subdued:rgb(255 255 255 / .60);\n  --color-border:rgb(255 255 255 / .22);--color-border-rgb:255 255 255;\n  color:#fff;\n}\n.footer-content a,.utilities a,\n.footer-content .text-block,.utilities .text-block,\n.utilities__text,.footer-utilities__text,\n.footer-content svg,.utilities svg{color:#fff}\n.footer-content a:hover,.utilities a:hover{color:rgb(255 255 255 / .72)}\n/* Enlaces de los menus: subrayado al pasar por encima, para que se vea\n   que cada palabra (Resi, Spedizioni, Informativa...) es pulsable. */\n.footer-content .menu-block a{text-decoration:none;text-underline-offset:3px}\n.footer-content .menu-block a:hover{text-decoration:underline}\n/* El campo de email se queda en blanco con texto oscuro */\n.footer-content .email-signup-block input{background:#fff!important;color:#111!important}\n.footer-content .email-signup-block input::placeholder{color:rgb(0 0 0 / .45)!important}\n/* Boton blanco con letra negra (La nostra storia / Iscrivimi) */\n.footer-content .button-custom,.footer-content .button-custom svg{color:#000}\n</style>",
