{%- doc -%}
  Úrsula Privée · carrusel de reseñas con foto.
  Se usa en la portada y en todas las fichas de producto.
  Los textos viven en el snippet up-review-data (fuente unica).
{%- enddoc -%}
{%- capture urv_data -%}{%- render 'up-review-data' -%}{%- endcapture -%}
{%- liquid
  assign urv_items = urv_data | strip | split: '~~'
  assign urv_t1 = 'Cosa dicono'
  assign urv_t2 = 'le nostre clienti?'
  assign urv_txt = 'Recensioni' | append: urv_t1 | append: urv_t2
-%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&text={{ urv_txt | url_encode }}&display=swap" media="print" onload="this.media='all'">
<section class="urv" id="urv-{{ section.id }}" aria-labelledby="urvh-{{ section.id }}">
  <header class="urv-h">
    <p class="urv-e">Recensioni</p>
    <h2 id="urvh-{{ section.id }}">{{ urv_t1 }} <em>{{ urv_t2 }}</em></h2>
    <span class="urv-r" aria-hidden="true"></span>
  </header>
  <div class="urv-w">
    <button type="button" class="urv-a urv-a--p" data-d="p" aria-label="Recensione precedente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <ul class="urv-l" role="list">
      {%- for it in urv_items -%}
      {%- assign p = it | strip | split: '|' -%}
      {%- assign n = p[1] | times: 1 -%}
      <li class="urv-c">
        <div class="urv-i">
          <img src="{{ p[0] | strip }}" alt="Recensione di {{ p[3] | strip | escape }}" loading="lazy" width="800" height="1000">
          <span class="urv-q" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9.5 6C6.9 7.4 5.3 9.8 5.3 12.6c0 .5.1 1 .2 1.4-.6.5-1 1.3-1 2.2 0 1.6 1.2 2.8 2.8 2.8s2.8-1.2 2.8-2.8c0-1.5-1.1-2.7-2.6-2.8.3-2 1.5-3.7 3.4-4.8L9.5 6zm8 0c-2.6 1.4-4.2 3.8-4.2 6.6 0 .5.1 1 .2 1.4-.6.5-1 1.3-1 2.2 0 1.6 1.2 2.8 2.8 2.8s2.8-1.2 2.8-2.8c0-1.5-1.1-2.7-2.6-2.8.3-2 1.5-3.7 3.4-4.8L17.5 6z" fill="currentColor"/></svg></span>
        </div>
        <div class="urv-b">
          <p class="urv-s" aria-label="{{ n }} di 5 stelle">{%- for i in (1..n) -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.6 7 .8-5.2 4.8 1.4 7L12 17.8 5.8 21.2l1.4-7L2 9.4l7-.8L12 2z" fill="currentColor"/></svg>{%- endfor -%}</p>
          <p class="urv-t">{{ p[2] | strip }}</p>
          <p class="urv-n">{{ p[3] | strip }}</p>
        </div>
      </li>
      {%- endfor -%}
    </ul>
    <button type="button" class="urv-a urv-a--n" data-d="n" aria-label="Recensione successiva"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  </div>
</section>
<style>
.section:has(> .urv){display:block;max-width:100%;padding-inline:0}
.urv{--k:#1c1a17;--m:#6f655c;--g:#e8a317;--f:'Cormorant Garamond',Georgia,serif;--e:cubic-bezier(.22,.61,.36,1);--gap:clamp(12px,1.6vw,20px);--edge:clamp(16px,3vw,48px);grid-column:1/-1;display:block;width:100%;max-width:100vw;min-width:0;padding:clamp(32px,5vw,64px) 0;color:var(--k)}
.urv *{box-sizing:border-box}
.urv-h,.urv-w,.urv-l{min-width:0;max-width:100%}
.urv-h{text-align:center;max-width:1320px;margin:0 auto clamp(20px,3vw,36px);padding:0 var(--edge)}
.urv-h h2{margin:0;font:300 clamp(2rem,5vw,3.6rem)/1.08 var(--f);overflow-wrap:break-word;word-break:normal;text-wrap:balance}
.urv-h h2 em{font-weight:300}
.urv-e{margin:0 0 8px;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--m)}
.urv-r{display:block;width:48px;height:1px;margin:14px auto 0;background:var(--k);opacity:.45}
.urv-w{position:relative;max-width:1320px;margin:0 auto}
.urv-l{display:flex;gap:var(--gap);margin:0;padding:8px var(--edge);list-style:none;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline-start:var(--edge);scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
.urv-l::-webkit-scrollbar{display:none}
.urv-c{flex:0 0 min(78%,320px);scroll-snap-align:start;display:flex;flex-direction:column;border-radius:16px;overflow:hidden;background:#f6f3ef}
.urv-i{position:relative;aspect-ratio:4/5;background:#efe9e1}
.urv-i img{width:100%;height:100%;object-fit:cover;display:block}
.urv-q{position:absolute;right:14px;bottom:-18px;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--k);color:#fff}
.urv-q svg{width:19px;height:19px}
.urv-b{flex:1;padding:30px 20px 26px;text-align:center}
.urv-s{display:flex;justify-content:center;gap:3px;margin:0 0 12px;color:var(--g)}
.urv-s svg{width:17px;height:17px}
.urv-t{margin:0 0 14px;font-size:15px;line-height:1.65;color:#2b2621}
.urv-n{margin:0;font-style:italic;font-size:14px;color:var(--m)}
.urv-a{position:absolute;top:34%;z-index:2;display:grid;place-items:center;width:38px;height:38px;padding:0;border:0;border-radius:50%;background:#fff;color:var(--k);box-shadow:0 2px 14px rgb(0 0 0/.16);cursor:pointer;transition:opacity .3s var(--e),transform .4s var(--e)}
.urv-a svg{width:19px;height:19px}
.urv-a--p{left:6px}.urv-a--n{right:6px}
.urv-a[disabled]{opacity:0;pointer-events:none}
@media(min-width:750px){
  .urv-c{flex-basis:calc((100% - 2*var(--gap) - 2*var(--edge))/3)}
  .urv-a{width:44px;height:44px;top:38%}
  .urv-a svg{width:21px;height:21px}
}
@media(hover:hover){.urv-a:hover{transform:scale(1.08)}}
@media(prefers-reduced-motion:reduce){.urv *{transition:none!important}.urv-l{scroll-behavior:auto}}
</style>
<script>
(()=>{const r=document.getElementById('urv-{{ section.id }}');if(!r)return;
const l=r.querySelector('.urv-l'),p=r.querySelector('.urv-a--p'),n=r.querySelector('.urv-a--n');
const step=()=>{const c=l.querySelector('.urv-c');return c?c.getBoundingClientRect().width+parseFloat(getComputedStyle(l).columnGap||16):300};
[p,n].forEach(b=>b&&b.addEventListener('click',()=>l.scrollBy({left:b.dataset.d==='n'?step():-step(),behavior:'smooth'})));
const upd=()=>{const max=l.scrollWidth-l.clientWidth;p.disabled=l.scrollLeft<4;n.disabled=l.scrollLeft>=max-4};
l.addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd);upd();})();
</script>
