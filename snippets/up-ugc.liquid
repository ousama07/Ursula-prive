{%- doc -%}
  Úrsula Privée · galeria UGC (solo fotos) con movimiento automatico.
  Las fotos salen del snippet up-review-data (primer campo de cada linea),
  asi que se mantiene una unica fuente de imagenes.
  Se usa en las fichas de producto, debajo de "Completa il tuo outfit".
{%- enddoc -%}
{%- capture ugc_data -%}{%- render 'up-review-data' -%}{%- endcapture -%}
{%- liquid
  assign ugc_items = ugc_data | strip | split: '~~'
  assign ugc_t1 = 'Le nostre clienti con'
  assign ugc_t2 = 'Úrsula Privée'
  assign ugc_txt = 'Community' | append: ugc_t1 | append: ugc_t2
-%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&text={{ ugc_txt | url_encode }}&display=swap" media="print" onload="this.media='all'">
<section class="ugc" id="ugc-{{ section.id }}" aria-labelledby="ugch-{{ section.id }}">
  <header class="ugc-h">
    <p class="ugc-e">Community</p>
    <h2 id="ugch-{{ section.id }}">{{ ugc_t1 }} <em>{{ ugc_t2 }}</em></h2>
    <span class="ugc-r" aria-hidden="true"></span>
  </header>
  <div class="ugc-w">
    <ul class="ugc-l" role="list" tabindex="0" aria-label="Foto delle nostre clienti">
      {%- for pass in (1..2) -%}
      {%- for it in ugc_items -%}
      {%- assign u = it | strip | split: '|' | first | strip -%}
      {%- if u != blank -%}
      <li class="ugc-c ugc-c--{{ forloop.index | modulo: 3 }}"{% if pass == 2 %} aria-hidden="true"{% endif %}>
        <img src="{{ u }}" alt="{% if pass == 1 %}Cliente di Úrsula Privée{% endif %}" loading="lazy" decoding="async" width="800" height="1000" onerror="this.closest('.ugc-c').remove()">
      </li>
      {%- endif -%}
      {%- endfor -%}
      {%- endfor -%}
    </ul>
    <p class="ugc-b"><strong>+6.000 clienti</strong> soddisfatte</p>
  </div>
</section>
<style>
.section:has(> .ugc){display:block;max-width:100%;padding-inline:0}
.ugc{--k:#1c1a17;--m:#6f655c;--f:'Cormorant Garamond',Georgia,serif;--gap:clamp(10px,1.2vw,16px);--h:clamp(230px,30vw,420px);grid-column:1/-1;display:block;width:100%;max-width:100vw;min-width:0;padding:clamp(32px,5vw,64px) 0;color:var(--k)}
.ugc *{box-sizing:border-box}
.ugc-h{text-align:center;max-width:1320px;margin:0 auto clamp(20px,3vw,36px);padding:0 clamp(16px,3vw,48px)}
.ugc-h h2{margin:0;font:300 clamp(1.9rem,4.4vw,3.2rem)/1.1 var(--f);overflow-wrap:break-word;text-wrap:balance}
.ugc-h h2 em{font-weight:300}
.ugc-e{margin:0 0 8px;font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--m)}
.ugc-r{display:block;width:48px;height:1px;margin:14px auto 0;background:var(--k);opacity:.45}
.ugc-w{position:relative;width:100%;min-width:0}
.ugc-l{display:flex;align-items:center;gap:var(--gap);margin:0;padding:0 var(--gap);list-style:none;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;cursor:grab}
.ugc-l::-webkit-scrollbar{display:none}
.ugc-l.is-drag{cursor:grabbing;scroll-behavior:auto}
.ugc-l:focus-visible{outline:2px solid var(--k);outline-offset:3px}
.ugc-c{flex:0 0 auto;height:var(--h);aspect-ratio:3/4;border-radius:10px;overflow:hidden;background:#efe9e1}
.ugc-c--2{aspect-ratio:4/5}
.ugc-c--0{aspect-ratio:1/1}
.ugc-c img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none;-webkit-user-drag:none;user-select:none}
.ugc-b{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:2;margin:0;padding:clamp(12px,1.6vw,18px) clamp(18px,2.6vw,32px);border-radius:999px;background:#fff;color:var(--k);font-size:clamp(14px,1.5vw,19px);line-height:1.2;white-space:nowrap;box-shadow:0 6px 30px rgb(0 0 0/.14);pointer-events:none}
.ugc-b strong{font-weight:700}
@supports (mask-image:linear-gradient(#000,#000)){
  .ugc-w{-webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
}
@media(prefers-reduced-motion:reduce){.ugc-l{scroll-behavior:auto}}
</style>
<script>
(()=>{
  const r=document.getElementById('ugc-{{ section.id }}');if(!r)return;
  const l=r.querySelector('.ugc-l');if(!l)return;
  const slow=matchMedia('(prefers-reduced-motion: reduce)');
  const SPD=0.042;
  let half=0,raf=0,last=0,hold=0,drag=false,sx=0,sl=0,seen=false,resume=0;
  const measure=()=>{half=l.scrollWidth/2};
  const wrap=()=>{if(half<=0)return;if(l.scrollLeft>=half)l.scrollLeft-=half;else if(l.scrollLeft<=0)l.scrollLeft+=half};
  const tick=t=>{
    const dt=last?Math.min(t-last,60):0;last=t;
    if(!hold&&!drag&&half>0){l.scrollLeft+=dt*SPD;wrap()}
    raf=requestAnimationFrame(tick);
  };
  const play=()=>{if(raf||slow.matches)return;last=0;raf=requestAnimationFrame(tick)};
  const stop=()=>{if(!raf)return;cancelAnimationFrame(raf);raf=0};
  const hgrab=()=>{hold++};
  const hfree=()=>{hold=Math.max(0,hold-1)};
  r.addEventListener('pointerenter',hgrab);
  r.addEventListener('pointerleave',hfree);
  l.addEventListener('focusin',hgrab);
  l.addEventListener('focusout',hfree);
  l.addEventListener('pointerdown',e=>{
    if(e.pointerType==='mouse'&&e.button!==0)return;
    drag=true;sx=e.clientX;sl=l.scrollLeft;l.classList.add('is-drag');
    if(e.pointerType==='mouse'){try{l.setPointerCapture(e.pointerId)}catch(_){}}
  });
  l.addEventListener('pointermove',e=>{if(!drag)return;l.scrollLeft=sl-(e.clientX-sx);wrap()});
  const end=()=>{
    if(!drag)return;drag=false;l.classList.remove('is-drag');
    clearTimeout(resume);hold++;resume=setTimeout(()=>{hold=Math.max(0,hold-1)},1400);
  };
  ['pointerup','pointercancel'].forEach(t=>l.addEventListener(t,end));
  l.addEventListener('scroll',wrap,{passive:true});
  addEventListener('resize',measure,{passive:true});
  document.addEventListener('visibilitychange',()=>{document.hidden?stop():play()});
  const io=new IntersectionObserver(es=>{
    es.forEach(e=>{
      if(e.isIntersecting){
        measure();
        if(!seen){seen=true;if(half>0)l.scrollLeft=half/2}
        play();
      }else stop();
    });
  },{rootMargin:'200px'});
  io.observe(r);
  if(document.readyState==='complete')measure();else addEventListener('load',measure,{once:true});
})();
</script>
