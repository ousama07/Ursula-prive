{%- comment -%}
  ÚRSULA PRIVÉE · BARRA PRE-BLACK FRIDAY

  Barra negra a todo lo ancho, entre la barra de anuncios y el encabezado.

  PARA CAMBIAR LA FECHA DE FIN: edita upbf_fine. Es una fecha fija y
  publica, igual para todos los visitantes, con la hora de Italia.
  Cuando pasa, la barra desaparece sola: no se reinicia por visitante.

  PARA CAMBIAR EL DESCUENTO: edita upbf_sconto.
{%- endcomment -%}
{%- liquid
  assign upbf_fine = '2026-11-23T11:31:00+01:00'
  assign upbf_sconto = '-50%'
-%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,500;1,600&text=Fridayfinoal&display=swap" media="print" onload="this.media='all'">

<div class="upbf" data-upbf data-upbf-fine="{{ upbf_fine }}" hidden>
  <div class="upbf-w">

    <div class="upbf-brand">
      <span class="upbf-pre">PRE-BLACK</span>
      <span class="upbf-fri">Friday</span>
    </div>

    <span class="upbf-div" aria-hidden="true"></span>

    <div class="upbf-off">
      <span class="upbf-upto">fino al</span>
      <span class="upbf-pct">{{ upbf_sconto }}</span>
    </div>

    <span class="upbf-div" aria-hidden="true"></span>

    <div class="upbf-cd">
      <span class="upbf-lbl">TERMINA<br>TRA</span>
      <span class="upbf-box"><b data-upbf-h>00</b><i>ORE</i></span>
      <span class="upbf-sep">:</span>
      <span class="upbf-box"><b data-upbf-m>00</b><i>MIN</i></span>
      <span class="upbf-sep">:</span>
      <span class="upbf-box upbf-box--s"><b data-upbf-s>00</b><i>SEC</i></span>
    </div>

  </div>
</div>

<style>
/* A todo lo ancho: la seccion del encabezado es una rejilla con margenes
   laterales, asi que la barra ocupa todas las columnas. */
.shopify-section:has(.upbf) .section{padding-block:0!important}
.upbf{grid-column:1/-1!important;justify-self:stretch!important;width:100%!important}

.upbf{position:relative;background:#000;color:#fff;overflow:hidden;
  --rojo:#ee1f33;--gris:#9a938c;
  --f:'Playfair Display',Georgia,serif}
.upbf[hidden]{display:none}
.upbf *{box-sizing:border-box}
.upbf::before{content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(62% 150% at 50% 115%,rgb(238 31 51/.38),transparent 62%)}

.upbf-w{position:relative;display:flex;align-items:center;justify-content:center;
  gap:clamp(12px,2.6vw,40px);padding:clamp(10px,1.4vw,18px) clamp(10px,3vw,40px)}

.upbf-div{flex:none;width:1px;align-self:stretch;min-height:clamp(34px,4.4vw,62px);
  background:rgb(255 255 255/.26)}

.upbf-brand{display:flex;align-items:baseline;gap:.18em;flex:none}
.upbf-pre{font-size:clamp(13px,2.3vw,38px);font-weight:800;letter-spacing:.1em;line-height:1}
.upbf-fri{font:italic 500 clamp(17px,2.7vw,44px)/1 var(--f)}

.upbf-off{display:flex;align-items:baseline;gap:.3em;flex:none}
.upbf-upto{font:italic 500 clamp(11px,1.6vw,27px)/1 var(--f);color:#fff}
.upbf-pct{font-size:clamp(19px,2.9vw,48px);font-weight:800;letter-spacing:-.01em;line-height:1;color:var(--rojo)}

.upbf-cd{display:flex;align-items:center;gap:clamp(4px,.7vw,11px);flex:none}
.upbf-lbl{font-size:clamp(7px,.75vw,12px);line-height:1.3;letter-spacing:.2em;
  color:#fff;text-align:right;margin-right:clamp(2px,.5vw,8px)}
.upbf-box{display:flex;flex-direction:column;align-items:center;line-height:1}
.upbf-box b{font-size:clamp(18px,2.8vw,44px);font-weight:700;font-variant-numeric:tabular-nums;line-height:1}
.upbf-box i{font-size:clamp(7px,.72vw,11px);font-style:normal;letter-spacing:.18em;color:var(--gris);margin-top:.5em}
.upbf-box--s b{color:var(--rojo)}
.upbf-sep{font-size:clamp(15px,2.2vw,34px);font-weight:700;line-height:1;color:var(--rojo);
  align-self:flex-start;margin-top:clamp(1px,.2vw,4px)}

/* Movil: PRE-BLACK sobre Friday, como en el original */
@media(max-width:749px){
  .upbf-brand{flex-direction:column;align-items:flex-start;gap:1px}
  .upbf-pre{letter-spacing:.08em}
  .upbf-w{gap:10px;padding:8px 10px}
  .upbf-lbl{display:none}
}
@media(max-width:359px){
  .upbf-w{gap:7px}
  .upbf-div{display:none}
}
</style>

<script>
(() => {
  const el = document.querySelector('[data-upbf]');
  if (!el || el.dataset.upbfReady === '1') return;
  el.dataset.upbfReady = '1';

  const fin = new Date(el.dataset.upbfFine).getTime();
  if (isNaN(fin)) return;

  const h = el.querySelector('[data-upbf-h]');
  const m = el.querySelector('[data-upbf-m]');
  const s = el.querySelector('[data-upbf-s]');
  const dd = n => String(n).padStart(2, '0');

  const tick = () => {
    const falta = fin - Date.now();
    if (falta <= 0) { el.remove(); return; }
    const t = Math.floor(falta / 1000);
    h.textContent = dd(Math.floor(t / 3600));
    m.textContent = dd(Math.floor(t / 60) % 60);
    s.textContent = dd(t % 60);
    el.hidden = false;
  };

  tick();
  setInterval(tick, 1000);
})();
</script>
